# =============================================================================
# ARCHIMEDES — environment
# Copy to .env (cp .env.example .env) and fill in the values.
# Never commit .env. Variables read by the browser need the NEXT_PUBLIC_ prefix.
# =============================================================================

# --- NVIDIA Nemotron on Nebius Token Factory (ALL LLM inference goes here) ---
# Get a key at https://studio.nebius.com (hackathon credits apply).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/

# Model IDs — confirm the exact IDs in the Token Factory model catalog before
# running (https://studio.nebius.com/studio/models). Newer Nemotron IDs can be
# dropped in here without code changes; the routing tiers stay the same:
#   NANO  = fast & cheap : extraction, classification, chat, JSON structuring
#   SUPER = mid tier     : research planning, compliance audit, section critique
#   ULTRA = heavy        : full proposal drafting, revision, executive summary
NEMOTRON_NANO_MODEL=nvidia/Llama-3_1-Nemotron-Nano-8B-v1
NEMOTRON_SUPER_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1
NEMOTRON_ULTRA_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1

# --- Tavily (live web research; free credits are enough for the demo) -------
TAVILY_API_KEY=

# --- Supabase (Postgres + Storage + Realtime) — free tier is enough ---------
# Project settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role bypasses RLS — used only by the API/worker server-side, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy HS256 JWT secret (Dashboard → Settings → API → JWT Secret).
# Leave empty for newer projects — the API verifies tokens via Supabase's JWKS instead.
SUPABASE_JWT_SECRET=

# --- Frontend (mirrors of the values above; safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Worker runtime ----------------------------------------------------------
# true  → the API spawns worker/main.py as a local subprocess (laptop-friendly;
#         this is the `make api` + `make worker` path and the default for judges)
# false → a dedicated worker (docker compose / Nebius Serverless) polls & claims jobs
LOCAL_WORKER_MODE=true

# When true, POST /projects/{id}/run submits a Nebius Serverless Job instead.
NEBIUS_SERVERLESS_ENABLED=false
NEBIUS_SERVERLESS_JOB_IMAGE=
NEBIUS_PROJECT_ID=
# Endpoint that accepts job submissions when serverless mode is on
# (confirm the exact URL in the Nebius console before a live deploy).
NEBIUS_JOBS_API_URL=https://api.nebius.com/v2/jobs

# true → deterministic fixtures instead of live model calls. Lets `make test`
# and UI walkthroughs run with zero credits and zero flakiness.
MOCK_LLM=false

# --- Tuning (defaults are sensible — you can ignore this block) --------------
# Document chunking / retrieval granularity (tokens)
CHUNK_TARGET_TOKENS=700
CHUNK_OVERLAP_TOKENS=60
# LLM robustness: retries with exponential backoff on 429/5xx/timeouts
LLM_TIMEOUT_SECONDS=120
LLM_RETRY_ATTEMPTS=4
LLM_RETRY_WAIT_MIN_SECONDS=1
LLM_RETRY_WAIT_MAX_SECONDS=20
# Tavily HTTP timeout (seconds)
TAVILY_TIMEOUT_SECONDS=30
# CORS origins for the API (comma-separated; * for local dev)
CORS_ORIGINS=*
